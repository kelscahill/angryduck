#. Translators: %s - the plugin name.
#: includes/Classes/License_Manager.php:1430
#, php-format
msgid "%1$sAction required!%2$s Enter your license for %3$s to continue."
msgstr ""
"%1$s¡Acción requerida!%2$s Introduzca su licencia de %3$s para continuar."

#: includes/Classes/License_Manager.php:1442
msgid ""
"Enter your license to full activate Wholesale Suite and gain access to "
"automatic updates, technical support, and premium features."
msgstr ""
"Introduzca su licencia para activar completamente Wholesale Suite y obtener "
"acceso a actualizaciones automáticas, soporte técnico y funciones premium."

#. Translators: %1$s - the purchase link opening tag, %2$s - the purchase link closing tag.
#: includes/Classes/License_Manager.php:1446
#, php-format
msgid ""
"Don’t worry, your wholesale customers & orders completely safe and your "
"premium wholesale features are still working. But you will need to enter a "
"license key to continue using Wholesale Suite. If you don’t have a license, "
"please %1$spurchase one to proceed%2$s."
msgstr ""
"No se preocupe, sus clientes mayoristas y pedidos están completamente "
"seguros y sus funciones premium mayoristas siguen funcionando. Sin embargo, "
"necesitará introducir una clave de licencia para continuar usando Wholesale "
"Suite. Si no tiene una licencia, %1$sadquiera una para continuar%2$s."

